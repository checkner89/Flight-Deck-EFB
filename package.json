{
  "name": "flight-deck-efb",
  "productName": "Flight Deck EFB",
  "version": "1.7.1",
  "description": "Flight Deck EFB for MSFS with a local MSFS 2024 native EFB Community package builder, route bridging, flight intelligence, turnaround coordination, taxi safety and guarded simulator integrations.",
  "author": "checkner89",
  "license": "MIT",
  "type": "module",
  "main": "src/electron-main.mjs",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "prepare-data": "node scripts/build-ourairports.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "leaflet": "1.9.4",
    "node-simconnect": "^4.2.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "de.checkner.flightdeckefb",
    "productName": "Flight Deck EFB",
    "artifactName": "Flight-Deck-EFB-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-simconnect/**"
    ],
    "files": [
      "public/**/*",
      "src/**/*",
      "data/**/*",
      "MSFS-2024-EFB-App/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "public/assets/app-icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flight Deck EFB",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "checkner89",
        "repo": "Flight-Deck-EFB",
        "releaseType": "release"
      }
    ]
  }
}
